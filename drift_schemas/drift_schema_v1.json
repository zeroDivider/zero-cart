  "fixed_sql": [
    {
      "name": "stores",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stores\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color_key\" TEXT NOT NULL, \"address\" TEXT NULL, \"note\" TEXT NULL, \"archived_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(name)) BETWEEN 1 AND 40));"
        }
      ]
    },
    {
      "name": "shopping_lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_lists\" (\"id\" TEXT NOT NULL, \"store_id\" TEXT NOT NULL REFERENCES stores (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"archived_at\" TEXT NULL, \"archive_reason\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(name)) BETWEEN 1 AND 60), CHECK (archive_reason IS NULL OR archive_reason IN ('manual', 'finished')), CHECK ((archived_at IS NULL) = (archive_reason IS NULL)));"
        }
      ]
    },
    {
      "name": "list_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"list_items\" (\"id\" TEXT NOT NULL, \"list_id\" TEXT NOT NULL REFERENCES shopping_lists (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"is_purchased\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_purchased\" IN (0, 1)), \"position\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(title)) BETWEEN 1 AND 50), CHECK (description IS NULL OR length(description) BETWEEN 1 AND 70));"
        }
      ]
    },
    {
      "name": "inbox_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inbox_items\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "wishlist_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wishlist_items\" (\"id\" TEXT NOT NULL, \"store_id\" TEXT NOT NULL REFERENCES stores (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
